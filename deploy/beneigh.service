[Unit]
Description=Beneigh Next.js Production App
After=network.target

[Service]
Type=simple
# 运行用户：请确保该用户对 APP_DIR 有读写权限（特别是 data/ 目录）
User=www-data
Group=www-data
WorkingDirectory=/var/www/beneigh

# 环境变量
Environment=NODE_ENV=production
Environment=PORT=3100
# 数据目录（better-sqlite3 的 WAL 库位于此）：默认即 APP_DIR/data，显式写出以防歧义
Environment=DATA_DIR=/var/www/beneigh/data

# 启动命令：next start 会读取 PORT 环境变量。
# 注意：systemd 环境下需保证 npm/node 在 www-data 的 PATH 中。
# 若 node 装在 nvm 下，请把下面 ExecStart 改为绝对路径，例如：
#   ExecStart=/root/.nvm/versions/node/v22.x.x/bin/node /var/www/beneigh/node_modules/next/dist/bin/next start -p 3100
ExecStart=/usr/bin/npm start

Restart=on-failure
RestartSec=5
# 限制日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beneigh

[Install]
WantedBy=multi-user.target
