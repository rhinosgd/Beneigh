# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
*.tsbuildinfo
cloudflared.exe
本地预览账号.txt
公网预览网址.txt
Beneigh-startup.log
local-preview-accounts.txt
public-preview-url.txt

# runtime data — contains the live SQLite DB with business data & admin credentials (never commit)
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# local round backups / temp artifacts
_backup_*/
*.tmp
